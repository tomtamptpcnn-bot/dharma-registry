NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only key for super-admin user provisioning. Use a Supabase secret key
# (sb_secret_...) or the legacy service_role key. Never expose with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Legacy alternative: use ANON_KEY if your project uses a legacy anon key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
